// To track a new storm:
// - copy this file to [stormName].scroll
// - update the settings below
// - run: scroll build

replace STORM_NAME Post-Tropical Cyclone Marie
replace REGION_LABEL Los Angeles
replace EMERGENCY_LABEL NHC Marie updates ↗
replace EMERGENCY_URL https://www.nhc.noaa.gov/refresh/graphics_ep3+shtml/081437.shtml?cone#contents
replace MAP_LABEL LOS ANGELES CAMERA MAP
replace MAP_NOTE Pins approximate
replace TV_HEADING Live TV coverage
replace PAGE_NOTE Los Angeles is the viewing area. See NHC graphics for Marie’s forecast track. Camera feeds may stop or require Play; forecast issue times are printed on graphics.
replace WEATHER_PROVIDER NOAA
replace MAP_LATITUDE 34.0522
replace MAP_LONGITUDE -118.2437
replace MAP_ZOOM 10

title STORM_NAME - REGION_LABEL · Storm Tracker
description Los Angeles-area coastal cameras and NOAA satellite imagery and forecast graphics for Marie.
baseUrl https://knowbooks.com/s/stormTracker/
openGraphImage marie.jpg
htmlLang en

readme.scroll

