// To track a new storm:
// - copy this file to [stormName].scroll
// - update the settings below
// - run: scroll build

replace STORM_NAME Hurricane Lowell
replace REGION_LABEL Kauaʻi Live Monitor
replace EMERGENCY_LABEL Hawaiʻi emergency updates ↗
replace EMERGENCY_URL https://dod.hawaii.gov/hiema/hurricane-lowell-updates/
replace MAP_LABEL KAUAʻI CAMERA MAP
replace MAP_NOTE Pins approximate
replace TV_HEADING Live TV coverage
replace PAGE_NOTE TV may show the latest newscast between live broadcasts. Camera feeds may stop or require Play. Forecast issue times are printed on graphics.
replace WEATHER_PROVIDER NOAA
replace MAP_LATITUDE 22.055
replace MAP_LONGITUDE -159.5
replace MAP_ZOOM 10

title REGION_LABEL · STORM_NAME
description Live Kauai coastal and field cameras, animated NOAA satellite imagery, storm forecasts, and Hawaii News Now coverage.
baseUrl https://knowbooks.com/s/stormTracker/
openGraphImage lowell.jpg
htmlLang en

readme.scroll

