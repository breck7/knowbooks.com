title About Knowbooks
description The mission of Knowbooks cannot be put in words.
baseUrl https://knowbooks.com/
openGraphImage og.png
favicon knowbooksLogo.svg
buildHtml
metaTags

header
 addClass about-header
 a Knowbooks
  href index.html
  addClass brand
 a Back to shop
  href index.html
  addClass header-link

main
 addClass about-main
 section
  addClass about-hero
  p Our mission
   addClass eyebrow
  h1 The mission of Knowbooks cannot be put in words…
  p Knowbooks arose from research into making science, language, and knowledge better serve humans.
   addClass intro
   link https://breck.lol/fordCat.html research
 section
  addClass about-section
  h2 Timeline
  ol
   addClass timeline
   li
    span July 8, 2026
     addClass when
    span Breck and Steph purchase Knowbooks.com.
     addClass what
   li
    span August 20, 2026
     addClass when
    span <a href="letterToInvestors2026.png">Letter to investors.</a>
     addClass what
   li
    span August 22, 2026
     addClass when
    span Knowbooks.com goes live.
     addClass what
   li
    span August 25, 2026
     addClass when
    span First online sale.
     addClass what
   li
    span October 2, 2026
     addClass when
    span Knowbooks Inc. name reserved in Hawaii.
     addClass what
   li
    span October 7, 2026
     addClass when
    span Knowbooks Inc. incorporates in Hawaii.
     addClass what
 section
  addClass about-section
  h2 Values
  p Keep calm and copy on.
   addClass value

footer
 addClass about-footer
 a Knowbooks
  href index.html
 p Built in Hawaii.

css
 :root {
  --paper: #f4efe5;
  --ink: #20211e;
  --muted: #706b61;
  --line: rgba(32, 33, 30, .18);
  --gold: #d9bc78;
  color-scheme: light;
  font-family: Georgia, "Times New Roman", serif;
 }
 * { box-sizing: border-box; }
 body { margin: 0; color: var(--ink); background: var(--paper); }
 a { color: inherit; }
 header, main, footer { display: block; max-width: 760px; margin: auto; padding-left: 24px; padding-right: 24px; }
 .about-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
 .brand { text-decoration: none; text-transform: uppercase; font: 700 11px/1 Arial, sans-serif; letter-spacing: .2em; }
 .header-link { text-decoration: none; color: var(--muted); text-transform: uppercase; font: 700 10px/1 Arial, sans-serif; letter-spacing: .13em; }
 .header-link:hover, .header-link:focus-visible { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
 .about-hero { padding: 72px 0 64px; }
 .eyebrow { margin: 0 0 22px; color: var(--muted); text-transform: uppercase; font: 700 10px/1 Arial, sans-serif; letter-spacing: .2em; }
 h1 { max-width: 620px; margin: 0 0 32px; font-size: clamp(40px, 8vw, 84px); font-weight: 400; line-height: .95; letter-spacing: -.05em; text-wrap: balance; }
 .intro { max-width: 620px; margin: 0; color: var(--muted); font-size: clamp(17px, 2vw, 22px); line-height: 1.55; }
 .intro a { color: var(--ink); text-underline-offset: 4px; }
 .about-section { padding: 56px 0; border-top: 1px solid var(--line); }
 h2 { margin: 0 0 28px; font-size: clamp(26px, 4vw, 40px); font-weight: 400; letter-spacing: -.03em; }
 .timeline { margin: 0; padding: 0; list-style: none; }
 .timeline li { position: relative; padding: 0 0 30px 30px; border-left: 1px solid var(--line); }
 .timeline li:last-child { padding-bottom: 0; }
 .timeline li::before { content: ""; position: absolute; left: -5px; top: 4px; width: 9px; height: 9px; border-radius: 50%; background: var(--gold); }
 .when { display: block; margin-bottom: 6px; color: var(--muted); text-transform: uppercase; font: 700 10px/1 Arial, sans-serif; letter-spacing: .16em; }
 .what { font-size: clamp(18px, 2.4vw, 24px); line-height: 1.4; }
 .value { max-width: 18ch; margin: 0; font-size: clamp(30px, 6vw, 60px); line-height: 1.02; letter-spacing: -.04em; }
 .about-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; padding-top: 26px; padding-bottom: 40px; border-top: 1px solid var(--line); color: var(--muted); font: 12px/1.5 Arial, sans-serif; }
 .about-footer p { margin: 0; }
 .about-footer a { color: var(--ink); text-decoration: none; text-transform: uppercase; font-weight: 700; letter-spacing: .16em; }
 a:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
 @media (max-width: 560px) { .about-hero { padding: 48px 0 44px; } .about-section { padding: 40px 0; } }
