  const change = (id, delta) => {
   const focused = document.activeElement;
   const control = focused?.hasAttribute("data-more") ? "data-more" : focused?.hasAttribute("data-less") ? "data-less" : null;
   const next = Math.min(products.get(id).design ? 1 : Infinity, (cart.get(id) || 0) + delta);
   next > 0 ? cart.set(id, next) : cart.delete(id);
   refresh();
   if (control) {
    const replacement = [...lines.querySelectorAll(`[${control}]`)].find(button => button.getAttribute(control) === id);
    (replacement || drawer.querySelector(".cart-close")).focus();
   }
  };
  function initDesigner() {
   const $ = selector => document.querySelector(selector), dialog = $('#designer'), title = $('#design-title'), byline = $('#design-byline');
   const art = $('#design-art'), signature = $('#design-signature'), marker = $('#design-marker'), status = $('#design-status');
   const key = 'knowbooks-signature-design', undo = [], hedcuts = new WeakMap();
   let design, draft, editing = false, erase = false, drawing, opener, photoVersion = 0;
   const fresh = () => ({ id: `custom-${cryptoId()}`, title: 'Your Knowbook', byline: '', color: 'navy', verbs: Array(5).fill(''), art: [], signature: [], portrait: [] });
   function cryptoId() { return globalThis.crypto.randomUUID().slice(0, 8); }
   const svg = body => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 255" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
   const paths = values => values.map(d => `<path d="${d}"/>`).join('');
   const dots = values => values.map(([x,y,r]) => `<circle cx="${x}" cy="${y}" r="${r}" fill="currentColor" stroke="none"/>`).join('');
   const cover = d => svg(dots(d.portrait) + paths(d.art) + `<g transform="translate(0 200)">${paths(d.signature)}</g>`);
   const product = d => ({ id: d.id, title: `${d.title} — Signature design deposit (${d.id})`, priceUsd: 5000, coverColor: coverPalette[d.color], cover: cover(d), design: d });
   const remember = () => {
