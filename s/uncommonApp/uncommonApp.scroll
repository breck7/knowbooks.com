importOnly

// uncommonApp: one application for every accelerator.
// Each concept below is one canonical question. readme.scroll turns them into
// questions.json, a classic form, and a one-textarea Scroll form.

abstractQuestionMeasureParser
 extends abstractStringMeasureParser
 javascript
  buildHtml() { return "" }
questionIdParser
 cue id
 extends abstractIdParser
 boolean isConceptDelimiter true
 boolean isMeasureRequired true
 javascript
  buildHtml() { return "" }
askParser
 cue ask
 description The question, merged from every accelerator that asks it.
 extends abstractQuestionMeasureParser
fieldParser
 cue field
 description line or text
 extends abstractQuestionMeasureParser
askedByParser
 cue askedBy
 description Accelerators that ask this.
 extends abstractQuestionMeasureParser
firmParser
 cue firm
 description Accelerator name.
 extends abstractQuestionMeasureParser
applyUrlParser
 cue applyUrl
 extends abstractQuestionMeasureParser
applyEmailParser
 cue applyEmail
 description Public applications or contact email, from the firm's own site where possible.
 extends abstractQuestionMeasureParser
basedInParser
 cue basedIn
 extends abstractQuestionMeasureParser
xParser
 cue x
 description Official X handle.
 extends abstractQuestionMeasureParser
fundedParser
 cue funded
 description Startups funded. Sources: 5k.vc portfolio counts (Nov 2026), Dealroom for 500 Global and Plug and Play, antler.co for Antler. ~ means a guess.
 extends abstractQuestionMeasureParser
investsParser
 cue invests
 description Standard investment, from official terms pages as of Oct 2026.
 extends abstractQuestionMeasureParser

