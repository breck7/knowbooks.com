title uncommonApp — one application for every accelerator
description Fill out one form to apply to the top startup accelerators in the world. Edit it as a form or as one plain-text Scroll document. Everything lives in the URL, so share the link to collaborate.
keywords accelerator application, Y Combinator, Techstars, 500 Global, Antler, Entrepreneur First, Blue Startups, Elemental, startup, one textarea, Scroll
baseUrl https://knowbooks.com/s/uncommonApp/
canonicalUrl https://knowbooks.com/s/uncommonApp/
openGraphImage og.png
favicon favicon.svg
permalink index.html
htmlLang en
buildHtml
metaTags

import uncommonApp.scroll

// The questions in uncommonApp.scroll and accelerators in uncommonApp.scroll become window.uncommonApp
buildConcepts uncommonApp.json
jsonScript uncommonApp.json

header
 a uncommon<b>App</b>
  href ./
  addClass mark
 nav
  button Form
   id formMode
   addClass on
  button Scroll
   id scrollMode
  button Copy link
   id copyLink
  button Submit
   id submit
   addClass on

main
 section
  addClass hero
  h1 One application. Every accelerator.
  For uncommon people: rare outliers who think they can lead. 22 questions, merged from the 10 top accelerators in the world. Type as a form or as one plain-text Scroll document. Every keystroke is saved in the URL, so send the link to a cofounder and edit together.
 div
  id classic
 textarea
  id particles
  spellcheck false
  placeholder name Ada Lovelace
 section
  addClass apply
  h2 Then apply
  table
   id accelerators

<dialog id="mail"><button id="closeMail">×</button><h2>Paste into your email</h2><label>BCC <button data-copy="bcc">Copy</button></label><input id="bcc" readonly><label>Subject <button data-copy="subject">Copy</button></label><input id="subject" readonly><label>Body <button data-copy="body">Copy</button></label><textarea id="body" readonly></textarea><p><a id="mailto">Open in my email app ↗</a></p></dialog>

footer
 a Source ↗
  href https://github.com/breck7/knowbooks.com/tree/main/s/uncommonApp
 span ·
 a More free software
  href ../index.html

css
 :root{--sage:#596d5f;--gold:#d9bc78;--ink:#1d2620;--paper:#f7f4ec;--line:#e2dccb}
 *{box-sizing:border-box}
 body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif}
 header{position:sticky;top:0;display:flex;justify-content:space-between;align-items:center;padding:12px 24px;background:var(--sage);z-index:2}
 .mark{color:#fff;text-decoration:none;font:600 22px Georgia,serif}.mark b{color:var(--gold)}
 nav button{font:inherit;font-size:14px;border:1px solid var(--gold);background:none;color:#fff;border-radius:99px;padding:5px 14px;margin-left:6px;cursor:pointer}
 nav button.on{background:var(--gold);color:var(--ink)}
 main{max-width:760px;margin:0 auto;padding:24px}
 h1{font:600 40px/1.1 Georgia,serif;color:var(--sage);margin:24px 0 8px}
 h2{font:600 26px Georgia,serif;color:var(--sage)}
 label{display:block;margin:22px 0 6px;font-weight:600}
 label small{display:block;font-weight:400;color:var(--sage);font-size:12px;letter-spacing:.03em}
 input,textarea{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff}
 #classic textarea{min-height:110px}
 input:focus,textarea:focus{outline:2px solid var(--gold)}
 #particles{display:none;min-height:70vh;font:15px/1.6 ui-monospace,Menlo,monospace;margin-top:20px}
 body.scroll #particles{display:block}body.scroll #classic{display:none}
 #accelerators{width:100%;border-collapse:collapse;font-size:15px}#accelerators td,#accelerators th{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);vertical-align:top}#accelerators a{color:var(--sage);font-weight:600}
 dialog{max-width:720px;width:92vw;border:0;border-radius:16px;padding:24px;background:var(--paper)}dialog::backdrop{background:#0006}
 dialog label button,#closeMail{font-size:12px;border:1px solid var(--sage);background:none;border-radius:99px;padding:2px 10px;cursor:pointer}#closeMail{float:right;font-size:18px}
 #body{min-height:40vh;font:14px/1.5 ui-monospace,Menlo,monospace}
 footer{text-align:center;padding:40px;color:var(--sage)}footer a{color:var(--sage)}

script
 const questions = window.uncommonApp.filter(c => c.ask)
 const accelerators = window.uncommonApp.filter(c => c.firm)
 const firm = id => accelerators.find(a => a.id === id).firm
 const $ = id => document.getElementById(id)
 let data = {}
 // Patch (https://breck.lol/patch.html): rows split by &, cells by =. Each line of an answer is a cell.
 const enc = s => encodeURIComponent(s).replace(/%20/g, "+")
 const dec = s => decodeURIComponent(s.replace(/\+/g, "%20"))
 const toPatch = d => Object.keys(d).filter(k => d[k]).map(k => [k, ...d[k].split("\n")].map(enc).join("=")).join("&")
 const fromPatch = s => Object.fromEntries(s.replace(/^[?#]/, "").split("&").filter(r => r).map(r => r.split("=").map(dec)).map(([k, ...v]) => [k, v.join("\n")]))
 // Scroll: one particle per answer. Multiline answers are indented one space.
 const toScroll = d => questions.filter(q => d[q.id]).map(q => q.field === "text" ? q.id + "\n " + d[q.id].replace(/\n/g, "\n ") : q.id + " " + d[q.id]).join("\n")
 const fromScroll = s => {
  const d = {}
  let key
  s.split("\n").forEach(line => {
   if (line.startsWith(" ") && key) d[key] += (d[key] ? "\n" : "") + line.slice(1)
   else if (line.trim()) [key, d[line.split(" ")[0]]] = [line.split(" ")[0], line.split(" ").slice(1).join(" ")]
  })
  return d
 }
 const render = source => {
  if (source !== "form") questions.forEach(q => $("q-" + q.id).value = data[q.id] || "")
  if (source !== "scroll") $("particles").value = toScroll(data)
  history.replaceState(null, "", "?" + toPatch(data))
  $("accelerators").innerHTML = "<tr><th>Accelerator</th><th>Based in</th><th>Invests</th><th>Answered</th></tr>" + accelerators.map(a => {
   const asked = questions.filter(q => q.askedBy.split(" ").includes(a.id))
   return `<tr><td><a href="${a.applyUrl}" target="_blank" rel="noopener">${a.firm} ↗</a></td><td>${a.basedIn}</td><td>${a.invests}</td><td>${asked.filter(q => data[q.id]).length}/${asked.length}</td></tr>`
  }).join("")
 }
 $("classic").innerHTML = questions.map(q => `<label for="q-${q.id}">${q.ask}<small>${q.askedBy.split(" ").map(firm).join(" · ")}</small></label>` + (q.field === "text" ? `<textarea id="q-${q.id}"></textarea>` : `<input id="q-${q.id}">`)).join("")
 $("classic").addEventListener("input", e => { data[e.target.id.slice(2)] = e.target.value; render("form") })
 $("particles").addEventListener("input", () => { data = fromScroll($("particles").value); render("scroll") })
 const mode = scroll => { document.body.classList.toggle("scroll", scroll); $("scrollMode").classList.toggle("on", scroll); $("formMode").classList.toggle("on", !scroll) }
 $("formMode").onclick = () => mode(false)
 $("scrollMode").onclick = () => mode(true)
 $("copyLink").onclick = () => navigator.clipboard.writeText(location.href).then(() => $("copyLink").textContent = "Copied!")
 data = fromPatch(location.search || location.hash)
 render()
 $("submit").onclick = () => {
  $("bcc").value = accelerators.map(a => a.applyEmail).join(", ")
  $("subject").value = "Application for " + (data.company || "")
  $("body").value = questions.filter(q => data[q.id]).map(q => "## " + q.ask + "\n\n" + data[q.id]).join("\n\n")
  $("mailto").href = "mailto:?bcc=" + encodeURIComponent($("bcc").value) + "&subject=" + encodeURIComponent($("subject").value) + "&body=" + encodeURIComponent($("body").value)
  $("mail").showModal()
 }
 $("closeMail").onclick = () => $("mail").close()
 $("mail").querySelectorAll("[data-copy]").forEach(b => b.onclick = () => navigator.clipboard.writeText($(b.dataset.copy).value).then(() => b.textContent = "Copied!"))

