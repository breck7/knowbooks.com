importOnly

covers.scroll

idParser
 extends abstractIdParser
 description Stable product identifier; periods are supported. Signature Knowbooks use creatorId.bookId (for example breck.ecommerce).

titleParser
 extends abstractStringMeasureParser
 description Product title.

signatureParser
 extends abstractStringMeasureParser
 description Optional name printed beneath the title as by [Signature].

shelfAtom
 extends atomAtom
 enum believer frontier special

shelfParser
 extends abstractStringMeasureParser
 atoms measureNameAtom shelfAtom
 catchAllAtomType shelfAtom
 description Space-separated shelves. A Knowbook may appear on multiple shelves.

priceUsdParser
 extends abstractIntegerMeasureParser
 description Website checkout price in whole US dollars.

coverColorAtom
 extends colorAtom
 enum navy ocean teal forest purple yellow orange coral brick burgundy brown

colorParser
 extends abstractEnumMeasureParser
 atoms measureNameAtom coverColorAtom
 description Optional default cover color: navy, ocean, teal, forest, purple, yellow, orange, coral, brick, burgundy, or brown. Unassigned books cycle yellow, navy, coral, forest, orange, purple, brick, teal, burgundy, ocean, brown in catalog order; assigned colors do not advance the cycle.

coverDescriptionParser
 extends abstractStringMeasureParser
 description Prose description of the cover artwork.

fulfillmentAtom
 extends atomAtom
 enum shipping pickup

fulfillmentParser
 extends abstractEnumMeasureParser
 atoms measureNameAtom fulfillmentAtom
 description Optional fulfillment method. Defaults to shipping; pickup requires in-person collection.

descriptionParser
 extends abstractStringMeasureParser
 description Optional product description.

skillsParser
 extends abstractStringMeasureParser
 description Space-separated verbs naming what the Knowbook teaches. At least five.

toolsParser
 extends abstractStringMeasureParser
 description Space-separated tools included in the kit.

// Source of truth for tag memberships. Tag definitions live in tags.scroll.
knowbookTagAtom
 extends atomAtom
 enum physicsTag chemistryTag biologyTag plantTag economicsTag psychologyTag computingTag materialsTag mechanicsTag electricityTag electromagnetismTag wavesTag fluidsTag natureTag buildingTag measurementTag creativeTag instantTag longTermTag multiplePeopleTag hazardTag gasTag liquidTag solidTag combustionTag energyTag temperatureTag pressureTag opticsTag musicTag growthTag nutritionTag healthTag financeTag businessTag startupsTag communicationTag cooperationTag machinesTag metalTag timeTag nuclearTag cyclesTag flightTag spaceTag motionTag geometryTag emotionalSkillsTag explorationTag parentingTag datingTag familyTag matingTag socialTag sportsTag teamSportsTag ballSportsTag combatSportsTag individualSportsTag

tagsParser
 extends abstractStringMeasureParser
 atoms measureNameAtom knowbookTagAtom
 catchAllAtomType knowbookTagAtom
 description Tags with an editorial Yes answer; tag definitions live in tags.scroll. At least one tag per Knowbook.

