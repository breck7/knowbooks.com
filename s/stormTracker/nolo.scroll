// Nolo dashboard. Build with: scroll build nolo.scroll
// Hawaii camera feeds inherited from the Norbert dashboard. Coordinates are approximate.
// NOAA advisory 12, 2026-09-23 05:00 HST: Tropical Depression Fifteen-E, EP152026.
// Nolo is the anticipated name; use the official advisory for current classification.

replace STORM_NAME Nolo
replace REGION_LABEL Hawaiʻi
replace EMERGENCY_LABEL CPHC storm updates ↗
replace EMERGENCY_URL https://www.nhc.noaa.gov/graphics_cp2.shtml?cone#contents
replace MAP_LABEL HAWAIʻI CAMERA MAP
replace MAP_NOTE All main islands · Pins approximate
replace TV_HEADING Live TV coverage
replace PAGE_NOTE Nolo watch: the September 23, 2026, 5 a.m. HST advisory identifies this system as Tropical Depression Fifteen-E. Follow CPHC for its current name and strength. Camera feeds may stop or require Play. Storm coverage may show replays between broadcasts. Forecast issue times are printed on NOAA graphics.
replace WEATHER_PROVIDER NOAA
replace MAP_LATITUDE 20.6
replace MAP_LONGITUDE -157.55
replace MAP_ZOOM 6

title STORM_NAME - REGION_LABEL · Storm Tracker
description Five Hawaii cameras, West Coast Storm Chasers, and NOAA satellite and forecast graphics for Nolo.
baseUrl https://knowbooks.com/s/stormTracker/
htmlLang en

readme.scroll

// Fit Niʻihau through Hawaiʻi Island on desktop and mobile.
script
 document.addEventListener('DOMContentLoaded', () => {
  if (!map) return;
  const fitHawaii = () => map.fitBounds([[18.85, -160.35], [22.35, -154.75]], {paddingTopLeft: [24, 65], paddingBottomRight: [24, 24]});
  fitHawaii();
  map.on('resize', fitHawaii);
 });

