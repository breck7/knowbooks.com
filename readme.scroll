buildToFileParser
 description Write the raw body to one or more files during the first build pass.
 extends abstractBuildOneCommandParser
 cueFromId
 baseParser blobParser
 example
  buildToFile robots.txt robots-copy.txt
   User-agent: *
   Disallow:
 javascript
  buildOutput() {
   return this.subparticlesToString()
  }
  async buildOne() {
   const { root } = this
   const { fileSystem, folderPath, filename, path } = root
   const content = this.buildOutput()
   for (const name of this.outputFileNames) {
    await fileSystem.writeProduct(path.join(folderPath, name), content)
    root.log(`💾 Built ${name} from ${filename}`)
   }
  }

buildToFile .gitignore
 *.html
