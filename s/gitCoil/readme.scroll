title gitCoil — Your lifetime GitHub activity as a coil
description Paste a GitHub profile and watch every year coil into one 3D helix. Runs in your browser.
baseUrl https://knowbooks.com/s/gitCoil/
openGraphImage og.png
favicon favicon.svg
permalink index.html
buildHtml
metaTags

header
 a gitCoil
  href ./
  addClass wordmark
 a Star us on GitHub ↗
  href https://github.com/breck7/knowbooks.com/tree/main/s/gitCoil
  target _blank
  rel noopener noreferrer
  addClass hint
section
 addClass panel
 form
  id lookup
  input
   id username
   name username
   type text
   value breck7
   placeholder user,user or user user
   aria-label GitHub username, comma to merge, space for a grid
   autocomplete off
  button Load
   type submit
 div
  id status
  role status
 div
  id meta
 p Own data? Get it, then drop the file here.
  addClass tip
 pre curl 'https://github-contributions-api.jogruber.de/v4/YOU?y=all' > github.json
  addClass code
  linkify false
main
 id stage
footer
 a Free software from Knowbooks.com
  href ../index.html
 span one loop = one year

css
 :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; color: #dff5e6; background: #050a07; }
 * { box-sizing: border-box; }
 html, body { height: 100%; margin: 0; overflow: hidden; background: radial-gradient(ellipse at 50% -10%, #0e2417, transparent 62%), #050a07; }
 #stage { position: fixed; inset: 0; z-index: 0; display: grid; grid-template-columns: repeat(var(--cols, 1), 1fr); grid-template-rows: repeat(var(--rows, 1), 1fr); }
 #stage.grid { padding-bottom: 42px; }
 #stage .cell { position: relative; min-width: 0; min-height: 0; }
 #stage canvas { display: block; width: 100%; height: 100%; }
 #stage .tag { position: absolute; left: 12px; bottom: 14px; z-index: 1; font-size: 13px; font-weight: 700; color: #eafff1; pointer-events: none; text-shadow: 0 1px 10px #050a07; }
 #stage .tag small { display: block; margin-top: 2px; font-size: 11px; font-weight: 500; color: #88b79c; }
 #meta a, #stage .tag a { color: inherit; text-decoration: none; pointer-events: auto; }
 #meta a:hover, #stage .tag a:hover { text-decoration: underline; text-underline-offset: 3px; }
 header, footer, .panel { position: fixed; z-index: 2; }
 header { top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: baseline; padding: 18px 22px; pointer-events: none; }
 .wordmark { font-size: 18px; font-weight: 800; letter-spacing: -.03em; color: #eafff1; text-decoration: none; pointer-events: auto; }
 .hint { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #5f8a70; text-decoration: none; pointer-events: auto; transition: color .18s; }
 .hint:hover { color: #9fe6b8; }
 .panel { top: 56px; left: 22px; width: min(348px, calc(100vw - 44px)); pointer-events: none; }
 .panel > * { pointer-events: auto; }
 form { display: flex; gap: 8px; padding: 7px; border: 1px solid #1c3a29; border-radius: 11px; background: rgba(9, 20, 14, .74); backdrop-filter: blur(10px); }
 input { flex: 1; min-width: 0; padding: 7px 9px; border: 0; background: transparent; color: #eafff1; font: inherit; font-size: 14px; outline: none; }
 input::placeholder { color: #4e6d5a; }
 button { padding: 0 14px; border: 0; border-radius: 7px; background: #2f8f57; color: #04140b; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
 button:hover { background: #39a866; }
 #status { min-height: 16px; margin: 8px 4px 0; font-size: 12px; color: #6fae87; }
 #status.bad { color: #ff9a8a; }
 #meta { margin: 4px 4px 0; font-size: 12px; color: #88b79c; }
 .tip { margin: 14px 4px 0; font-size: 11px; line-height: 1.7; color: #5b8069; }
 pre.code { margin: 8px 4px 0; padding: 8px 10px; border: 1px solid #1c3a29; border-radius: 8px; background: rgba(9, 20, 14, .7); color: #8fd7a8; font-family: ui-monospace, Menlo, monospace; font-size: 10px; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
 footer { bottom: 0; left: 0; right: 0; display: flex; justify-content: space-between; gap: 12px; padding: 14px 22px; font-size: 11px; color: #4f7260; }
 footer a { color: #7fb894; text-decoration: none; }
 body.drop #stage { outline: 2px dashed #39d353; outline-offset: -12px; }
 a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid #39d353; outline-offset: 2px; }
 @media (max-width: 560px) { .panel { top: 52px; } .hint { font-size: 10px; letter-spacing: .06em; } }

script
 (() => {
  // Data and 3D library.
  const API = 'https://github-contributions-api.jogruber.de/v4/';
  const THREE_URL = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js';
  const $ = id => document.getElementById(id);
  const stage = $('stage'), form = $('lookup'), input = $('username'), status = $('status'), meta = $('meta');
  // Deep link: ?u=username (also accepts ?user= or ?q=). The URL updates as you load.
  const params = new URLSearchParams(location.search);
  const DEFAULT = input.value || 'breck7';
  const shared = params.get('u') || params.get('user') || params.get('q');
  const setLink = name => {
   const url = new URL(location.href);
   if (name) url.searchParams.set('u', name);
   else url.searchParams.delete('u');
   history.replaceState(null, '', url);
  };
  const RADIUS = 1, PITCH = 0.46;
  let ready = false, pending = null, views = [];
  let theta = 0.7, phi = 1.3, targetPhi = 1.3;
  let dragging = false, lastX = 0, lastY = 0, resumeAt = 0;
  // Helpers.
  const now = () => performance.now();
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const isLeap = y => (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
  const dayOfYear = iso => Math.round((Date.parse(iso + 'T00:00:00Z') - Date.UTC(iso.slice(0, 4), 0, 1)) / 86400000) + 1;
  const totalOf = days => days.reduce((sum, d) => sum + d.count, 0);
  const spanOf = days => Number(days[days.length - 1].date.slice(0, 4)) - Number(days[0].date.slice(0, 4)) + 1;
  const say = (text, bad) => { status.textContent = text || ''; status.classList.toggle('bad', !!bad); };
  const usernameOf = value => {
   const match = (value || '').trim().match(/github\.com\/([A-Za-z0-9-]+)/i);
   return (match ? match[1] : (value || '').trim()).replace(/[^A-Za-z0-9-]/g, '');
  };
  // Commas merge users into one helix; spaces lay out a grid. Cap 8.
  const MAX_USERS = 8;
  const parseUsers = value => {
   const chunks = String(value || '').trim().replace(/\s*,\s*/g, ',').split(/\s+/);
   const groups = [];
   let extra = 0, total = 0;
   for (const chunk of chunks) {
    const names = chunk.split(',').map(usernameOf).filter(Boolean);
    if (!names.length) continue;
    const room = MAX_USERS - total;
    if (room <= 0) { extra += names.length; continue; }
    if (names.length > room) { groups.push(names.slice(0, room)); extra += names.length - room; total = MAX_USERS; }
    else { groups.push(names); total += names.length; }
   }
   return { groups, extra, text: groups.map(g => g.join(',')).join(' ') };
  };
  // Be liberal in what we accept: any shape, any common date format.
  const MONTHS = { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12 };
  const isDate = s => /^\d{4}-\d{2}-\d{2}$/.test(s);
  const toISODate = value => {
   if (value == null) return '';
   const raw = String(value).trim();
   if (/^\d{9,13}$/.test(raw)) { const n = Number(raw); const d = new Date(raw.length <= 10 ? n * 1000 : n); return isNaN(d) ? '' : d.toISOString().slice(0, 10); }
   const iso = raw.match(/(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/);
   if (iso) return iso[1] + '-' + String(iso[2]).padStart(2, '0') + '-' + String(iso[3]).padStart(2, '0');
   const named = raw.match(/([A-Za-z]{3})[a-z]*\s+(\d{1,2})\b.*?(\d{4})\s*$/);
   if (named && MONTHS[named[1].toLowerCase()]) return named[3] + '-' + String(MONTHS[named[1].toLowerCase()]).padStart(2, '0') + '-' + String(named[2]).padStart(2, '0');
   if (/[A-Za-z]/.test(raw)) { const parsed = Date.parse(raw); if (!isNaN(parsed)) return new Date(parsed).toISOString().slice(0, 10); }
   return '';
  };
  const STAMPS = ['created_at', 'createdAt', 'created', 'date', 'day', 'time', 'timestamp', 'posted_at', 'postedAt', 'tweeted_at', 'epoch', 'when'];
  const stamp = row => {
   if (typeof row === 'string' || typeof row === 'number') return toISODate(row);
   if (!row || typeof row !== 'object') return '';
   const inner = row.tweet && typeof row.tweet === 'object' ? row.tweet : row;
   for (const field of STAMPS) { if (inner[field] != null) { const date = toISODate(inner[field]); if (isDate(date)) return date; } }
   return '';
  };
  const rowCount = row => Math.max(0, Math.floor(Number(row.count != null ? row.count : row.total != null ? row.total : 1) || 0));
  const unwrap = raw => {
   if (Array.isArray(raw)) return raw;
   if (raw && typeof raw === 'object') { for (const key of ['contributions', 'data', 'items', 'rows', 'records', 'activity', 'days']) if (Array.isArray(raw[key])) return raw[key]; }
   return raw;
  };
  const fillRange = counts => {
   const dates = [...counts.keys()].sort();
   const today = new Date().toISOString().slice(0, 10);
   const startYear = dates.length ? Number(dates[0].slice(0, 4)) : Number(today.slice(0, 4));
   const out = [];
   const end = Date.parse(today + 'T00:00:00Z');
   for (let t = Date.parse(startYear + '-01-01T00:00:00Z'); t <= end; t += 86400000) {
    const iso = new Date(t).toISOString().slice(0, 10);
    out.push({ date: iso, count: counts.get(iso) || 0 });
   }
   return out;
  };
  const collect = rows => {
   const counts = new Map();
   if (Array.isArray(rows)) {
    const hasCount = rows.some(row => row && typeof row === 'object' && (row.count != null || row.total != null));
    for (const row of rows) {
     const date = stamp(row);
     if (!isDate(date)) continue;
     counts.set(date, (counts.get(date) || 0) + (hasCount && row && typeof row === 'object' ? rowCount(row) : 1));
    }
   } else if (rows && typeof rows === 'object') {
    for (const [key, value] of Object.entries(rows)) { const date = toISODate(key); if (isDate(date)) counts.set(date, (counts.get(date) || 0) + Math.max(0, Math.floor(Number(value) || 0))); }
   }
   return counts;
  };
  const toDays = raw => fillRange(collect(unwrap(raw)));
  const firstDate = cells => {
   for (const cell of cells) if (/^\d{4}[-/.]\d{1,2}[-/.]\d{1,2}/.test(cell)) return toISODate(cell);
   for (const cell of cells) if (/^\d{9,13}$/.test(cell)) return toISODate(cell);
   for (const cell of cells) { const date = toISODate(cell); if (isDate(date)) return date; }
   return '';
  };
  // JSON (any wrapper), JS assignments, or delimited text (comma, tab, semicolon, pipe).
  const parseDelimited = text => {
   const lines = text.split(/\r?\n/).filter(line => line.trim());
   if (!lines.length) return [];
   let delimiter = ',', best = -1;
   for (const candidate of ['\t', ',', ';', '|']) { const n = lines[0].split(candidate).length; if (n > best) { best = n; delimiter = candidate; } }
   const cells = lines.map(line => line.split(delimiter).map(cell => cell.trim().replace(/^"|"$/g, '')));
   const head = cells[0].map(cell => cell.toLowerCase());
   const di = head.findIndex(cell => /date|time|created|posted|when|day/.test(cell));
   const ci = head.findIndex(cell => /^(count|total|contributions|commits|number|num|n)$/.test(cell));
   const hasHeader = di >= 0 || ci >= 0;
   const body = hasHeader ? cells.slice(1) : cells;
   if (di >= 0 && ci >= 0) return body.map(row => ({ date: row[di], count: Number(row[ci]) })).filter(row => isDate(toISODate(row.date)));
   if (di >= 0) return body.map(row => ({ created_at: row[di] })).filter(row => isDate(toISODate(row.created_at)));
   return body.map(row => {
    const date = firstDate(row);
    if (!date) return null;
    const num = row.map(Number).find(n => Number.isFinite(n) && n >= 0 && n < 1e7);
    return { date, count: hasHeader || !Number.isFinite(num) ? 1 : num };
   }).filter(Boolean);
  };
  const parseArchive = (text, filename) => {
   let body = String(text).replace(/^\uFEFF/, '').trim();
   if (/^(window|var|const|let)\b/.test(body)) { const eq = body.indexOf('='); if (eq > -1) body = body.slice(eq + 1).trim().replace(/;\s*$/, ''); }
   if (/^[\[{]/.test(body) && !/\.(csv|tsv|txt)$/i.test(filename || '')) { try { return JSON.parse(body); } catch (error) { return parseDelimited(body); } }
   return parseDelimited(body);
  };
  // GitHub-ish green ramp for a 0–1 intensity.
  const ramp = t => {
   const a = [30, 120, 60], b = [70, 205, 100], c = [175, 255, 195];
   const m = t < 0.5 ? [a, b, t / 0.5] : [b, c, (t - 0.5) / 0.5];
   const mix = i => Math.round(m[0][i] + (m[1][i] - m[0][i]) * m[2]);
   return (mix(0) << 16) | (mix(1) << 8) | mix(2);
  };
  const labelSprite = text => {
   const canvas = document.createElement('canvas');
   canvas.width = 256; canvas.height = 128;
   const ink = canvas.getContext('2d');
   ink.font = 'bold 72px Inter, Arial, sans-serif';
   ink.fillStyle = '#7fe3a8';
   ink.textBaseline = 'middle';
   ink.fillText(text, 6, 68);
   const texture = new THREE.CanvasTexture(canvas);
   texture.minFilter = THREE.LinearFilter;
   const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture, transparent: true, depthWrite: false }));
   sprite.scale.set(0.85, 0.42, 1);
   return sprite;
  };
  const disposeOf = o => {
   if (o.geometry) o.geometry.dispose();
   if (o.material) { if (o.material.map) o.material.map.dispose(); o.material.dispose(); }
  };
  const resizeView = view => {
   const w = Math.max(1, view.el.clientWidth), h = Math.max(1, view.el.clientHeight);
   view.camera.aspect = w / h;
   view.camera.updateProjectionMatrix();
   view.renderer.setSize(w, h, false);
  };
  const bindOrbit = canvas => {
   canvas.style.touchAction = 'none';
   canvas.addEventListener('pointerdown', event => { dragging = true; lastX = event.clientX; lastY = event.clientY; canvas.setPointerCapture(event.pointerId); });
   canvas.addEventListener('pointermove', event => {
    if (!dragging) return;
    theta -= (event.clientX - lastX) * 0.008;
    targetPhi = clamp(targetPhi - (event.clientY - lastY) * 0.006, 0.4, 2.5);
    lastX = event.clientX; lastY = event.clientY; resumeAt = now() + 1400;
   });
   const release = () => { dragging = false; resumeAt = now() + 1400; };
   canvas.addEventListener('pointerup', release);
   canvas.addEventListener('pointercancel', release);
   canvas.addEventListener('wheel', event => {
    event.preventDefault();
    const view = views.find(v => v.renderer.domElement === canvas);
    if (view) view.targetDist = clamp(view.targetDist * (1 + Math.sign(event.deltaY) * 0.08), 4, 140);
   }, { passive: false });
  };
  const clearViews = () => {
   for (const view of views) {
    view.group.traverse(disposeOf);
    view.renderer.dispose();
    view.el.remove();
   }
   views = [];
  };
  const makeView = () => {
   const el = document.createElement('div');
   el.className = 'cell';
   const tag = document.createElement('div');
   tag.className = 'tag';
   const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
   renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
   el.appendChild(renderer.domElement);
   el.appendChild(tag);
   stage.appendChild(el);
   const scene = new THREE.Scene();
   const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 400);
   const group = new THREE.Group();
   scene.add(group);
   bindOrbit(renderer.domElement);
   const view = { el, tag, renderer, scene, camera, group, dist: 16, targetDist: 16 };
   resizeView(view);
   return view;
  };
  const layout = n => {
   const cols = n <= 1 ? 1 : n === 3 ? 3 : n <= 4 ? Math.min(n, 2) : n <= 6 ? 3 : 4;
   stage.style.setProperty('--cols', cols);
   stage.style.setProperty('--rows', Math.ceil(n / cols) || 1);
   stage.classList.toggle('grid', n > 1);
   clearViews();
   for (let i = 0; i < n; i++) views.push(makeView());
  };
  // One turn per year: angle spans each year, height rises with time.
  const draw = (view, days) => {
   view.group.traverse(disposeOf);
   view.group.clear();
   if (!days.length) { say('No contributions in that data.', true); return; }
   const first = Number(days[0].date.slice(0, 4)), last = Number(days[days.length - 1].date.slice(0, 4));
   const years = last - first + 1, height = years * PITCH, shift = height / 2;
   const peak = days.reduce((max, d) => Math.max(max, d.count), 1);
   const points = [], dots = [];
   for (const day of days) {
    const year = Number(day.date.slice(0, 4));
    const t = (dayOfYear(day.date) - 1) / (isLeap(year) ? 366 : 365);
    const angle = t * Math.PI * 2;
    const point = new THREE.Vector3(Math.cos(angle) * RADIUS, (year - first + t) * PITCH - shift, Math.sin(angle) * RADIUS);
    points.push(point);
    if (day.count > 0) dots.push([point, day.count]);
   }
   view.group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(points), new THREE.LineBasicMaterial({ color: 0x2f9a58, transparent: true, opacity: 0.45 })));
   if (dots.length) {
    const mesh = new THREE.InstancedMesh(new THREE.SphereGeometry(1, 10, 10), new THREE.MeshBasicMaterial(), dots.length);
    const matrix = new THREE.Matrix4(), color = new THREE.Color();
    dots.forEach(([point, count], i) => {
     const k = Math.log(1 + count) / Math.log(1 + peak);
     const size = 0.03 + 0.045 * k;
     matrix.makeScale(size, size, size).setPosition(point.x, point.y, point.z);
     mesh.setMatrixAt(i, matrix);
     mesh.setColorAt(i, color.setHex(ramp(k)));
    });
    mesh.instanceMatrix.needsUpdate = true;
    view.group.add(mesh);
   }
   for (let year = first; year <= last; year++) {
    const sprite = labelSprite(String(year));
    sprite.position.set(RADIUS + 0.34, (year - first) * PITCH - shift, 0);
    view.group.add(sprite);
   }
   const fov = THREE.MathUtils.degToRad(view.camera.fov);
   const fitY = (height / 2 + 0.4) / Math.tan(fov / 2);
   const fitX = (RADIUS + 0.8) / (Math.tan(fov / 2) * view.camera.aspect);
   view.targetDist = Math.max(5, Math.max(fitY, fitX) * 1.16);
  };
  const loop = () => {
   requestAnimationFrame(loop);
   if (!dragging && now() > resumeAt) theta += 0.0016;
   phi += (targetPhi - phi) * 0.12;
   for (const view of views) {
    view.dist += (view.targetDist - view.dist) * 0.08;
    view.camera.position.set(view.dist * Math.sin(phi) * Math.sin(theta), view.dist * Math.cos(phi), view.dist * Math.sin(phi) * Math.cos(theta));
    view.camera.lookAt(0, 0, 0);
    view.renderer.render(view.scene, view.camera);
   }
  };
  const setup = () => {
   addEventListener('resize', () => { for (const view of views) resizeView(view); });
   ready = true;
   requestAnimationFrame(loop);
   if (pending) { const p = pending; pending = null; showAll(p); }
  };
  const loadThree = () => {
   if (window.THREE) { setup(); return; }
   const script = document.createElement('script');
   script.src = THREE_URL;
   script.onload = setup;
   script.onerror = () => say('Could not load the 3D library.', true);
   document.head.appendChild(script);
  };
  const mergeDays = list => {
   const counts = new Map();
   for (const days of list) for (const day of days) counts.set(day.date, (counts.get(day.date) || 0) + day.count);
   return fillRange(counts);
  };
  const summary = (title, days) => title + ' · ' + totalOf(days).toLocaleString() + ' contributions · ' + spanOf(days) + ' years';
  const ghLink = name => /^[A-Za-z0-9-]+$/.test(name) ? '<a href="https://github.com/' + encodeURIComponent(name) + '" target="_blank" rel="noopener">' + name + '</a>' : name;
  const linkedTitle = names => names.map(ghLink).join(' + ');
  const showAll = entries => {
   if (!ready) { pending = entries; return; }
   layout(entries.length);
   entries.forEach((entry, i) => {
    draw(views[i], entry.days);
    const title = linkedTitle(entry.names || [entry.tag]);
    if (entries.length > 1) views[i].tag.innerHTML = title + '<small>' + totalOf(entry.days).toLocaleString() + ' · ' + spanOf(entry.days) + ' years</small>';
   });
   if (entries.length === 1) {
    const entry = entries[0];
    meta.innerHTML = linkedTitle(entry.names || [entry.tag]) + ' · ' + totalOf(entry.days).toLocaleString() + ' contributions · ' + spanOf(entry.days) + ' years';
   } else meta.textContent = '';
  };
  const fetchUser = async name => {
   const res = await fetch(API + encodeURIComponent(name) + '?y=all', { headers: { Accept: 'application/json' } });
   if (!res.ok) throw new Error(res.status === 404 ? 'No GitHub user named ' + name : 'GitHub data unavailable (' + name + ')');
   const days = toDays(await res.json());
   if (!days.length) throw new Error('No public contributions found for ' + name);
   return days;
  };
  // Load public profile(s), or any dropped JSON/CSV.
  const load = async raw => {
   const { groups, extra, text } = parseUsers(raw);
   if (!groups.length) { say('Enter a GitHub username or profile URL.', true); return; }
   input.value = text;
   say('Loading ' + groups.flat().join(', ') + '…');
   try {
    const errors = [];
    const fetched = {};
    await Promise.all(groups.flat().map(async name => {
     try { fetched[name] = await fetchUser(name); }
     catch (error) { errors.push(error.message || 'Could not load ' + name); }
    }));
    const entries = [];
    for (const group of groups) {
     const ok = group.filter(name => fetched[name]);
     if (!ok.length) continue;
     const days = mergeDays(ok.map(name => fetched[name]));
     entries.push({ days, names: ok, tag: ok.join(' + ') });
    }
    if (!entries.length) { say(errors.join(' ') || 'Could not load that profile.', true); return; }
    setLink(text);
    showAll(entries);
    const notes = [];
    if (extra) notes.push('Only the first ' + MAX_USERS + ' usernames are shown.');
    if (errors.length) notes.push(errors.join(' '));
    say(notes.join(' '), errors.length > 0);
   } catch (error) {
    say(error.message || 'Could not load that profile.', true);
   }
  };
  const readFile = file => {
   say('Reading ' + file.name + '…');
   file.text().then(text => {
    const days = toDays(parseArchive(text, file.name));
    if (!days.length) throw new Error('No contributions in that file');
    setLink('');
    showAll([{ days, names: [file.name], tag: file.name }]);
    say('');
   }).catch(error => say(error.message || 'Could not read that file.', true));
  };
  form.addEventListener('submit', event => { event.preventDefault(); load(input.value); });
  addEventListener('dragover', event => { event.preventDefault(); document.body.classList.add('drop'); });
  addEventListener('dragleave', event => { if (!event.relatedTarget) document.body.classList.remove('drop'); });
  addEventListener('drop', event => { event.preventDefault(); document.body.classList.remove('drop'); if (event.dataTransfer.files[0]) readFile(event.dataTransfer.files[0]); });
  loadThree();
  load(shared || DEFAULT);
  addEventListener('popstate', () => { load(new URLSearchParams(location.search).get('u') || DEFAULT); });
 })();
