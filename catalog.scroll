importOnly

covers.scroll

idParser
 extends abstractIdParser
 description Stable product identifier.

titleParser
 extends abstractStringMeasureParser
 description Product title.

statusParser
 extends abstractStringMeasureParser
 description Product status.

priceUsdParser
 extends abstractIntegerMeasureParser
 description Website checkout price in whole US dollars.

coverColorAtom
 extends colorAtom
 enum navy ocean teal forest purple yellow orange coral brick burgundy brown

colorParser
 extends abstractEnumMeasureParser
 atoms measureNameAtom coverColorAtom
 description Optional default cover color: navy, ocean, teal, forest, purple, yellow, orange, coral, brick, burgundy, or brown. Unassigned books cycle yellow, navy, coral, forest, orange, purple, brick, teal, burgundy, ocean, brown in catalog order; assigned colors do not advance the cycle.

symbolParser
 extends abstractStringMeasureParser
 description Symbol for cover.

descriptionParser
 extends abstractStringMeasureParser
 description Optional product description.

